"""samples — a consumer of @spaghetti_with_bazel (PLAN.md §3).

This is a standalone Bazel module that plays the game against its own
workspace. It overrides @spaghetti_with_bazel to the sibling checkout, declares a single
spaghetti_with_bazel_policy (the sample-specific rulebook), and hosts the report + spaghetti_with_bazel
entrypoints in //:BUILD.bazel. To compare platforms, build the report twice
under different --platforms; the config is one rulebook resolved in the
report's own configuration.

  bazel build //:report   --platforms=@spaghetti_with_bazel//platforms:linux
  bazel build //:report   --platforms=@spaghetti_with_bazel//platforms:windows
  bazel run   //:spaghetti_with_bazel
"""

# The reusable rules module, developed alongside this consumer.
bazel_dep(name = "spaghetti_with_bazel", version = "0.1.0")
git_override(
    module_name = "spaghetti_with_bazel",
    remote = "https://github.com/Sandruz/spaghetti_with_bazel.git",
    commit = "6077e833af941e1dd4ff6c6321b382866e4eab78",
)

# --- C/C++ + constraints -----------------------------------------------------
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.0.0")

# --- Hermetic C/C++ toolchain (zig-backed) -----------------------------------
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")
toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)

spaghetti_with_bazel = use_extension("@spaghetti_with_bazel//:extensions.bzl", "spaghetti_with_bazel")
spaghetti_with_bazel.config(
    shared_areas = ["common", "util"],
    allowlist = [],
    enabled_heuristics = ["misplaced", "healthy_shared", "overexposed", "area_cycle", "wrong_file_name"],
    filename_rules = {"_test": "test"},
)
use_repo(spaghetti_with_bazel, "spaghetti_config")
